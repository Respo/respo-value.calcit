{
  "version": "0.5.15",
  "packageManager": "yarn@4.18.0",
  "scripts": {
    "check": "calcit calcit.cirru --check-only",
    "check:deprecated": "calcit calcit.cirru analyze deprecated",
    "check:quality": "calcit calcit.cirru analyze quality --baseline config/calcit-quality.cirru",
    "build:js": "calcit calcit.cirru js && vite build --base=${VITE_BASE_URL:-/}"
  },
  "dependencies": {
    "@calcit/procs": "0.29.0-alpha.19"
  },
  "devDependencies": {
    "bottom-tip": "^0.1.5",
    "vite": "8.3.1"
  }
}
